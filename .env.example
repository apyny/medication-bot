# ---- Telegram ----
# Get this from @BotFather (see SETUP.md step 1)
TELEGRAM_BOT_TOKEN=

# ---- Google Sheets ----
# Spreadsheet ID from the Google Sheet URL (see SETUP.md step 2)
# Example: https://docs.google.com/spreadsheets/d/<THIS_IS_THE_ID>/edit
GOOGLE_SHEET_ID=

# Path to the downloaded service account JSON file (see SETUP.md step 2)
# In local dev: keep this file in the project and set the path, e.g. service_account.json
# On Railway/Render: paste the file contents into the GOOGLE_CREDENTIALS_JSON env var instead.
GOOGLE_CREDENTIALS_FILE=service_account.json
# Optional override: raw JSON string of the service account (used on Railway/Render)
GOOGLE_CREDENTIALS_JSON=
# Recommended for cloud hosts: the service-account JSON base64-encoded into a
# single line (no newline issues). Generate with:
#   base64 -i service_account.json | tr -d '\n'
# (or `openssl base64 -in service_account.json -A` on macOS). If set, this takes
# precedence over GOOGLE_CREDENTIALS_JSON.
GOOGLE_CREDENTIALS_B64=

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Timezone ----
# IANA timezone used for schedule times and history timestamps
# e.g. Europe/Moscow, Europe/London, America/New_York
TIMEZONE=Europe/Moscow